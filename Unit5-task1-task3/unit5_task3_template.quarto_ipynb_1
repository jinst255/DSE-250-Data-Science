   "metadata": {},
   "source": [
    "# Task 3 (ML)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "dbe37eff",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Include and execute your code here\n",
    "df = df.filter(pl.any_horizontal(pl.col(r\"^seen_Episode.*$\").is_not_null()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "f4abda92",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = df.with_columns(\n",
    "    (pl.col(\"income_int\") >= 50000).cast(pl.Int8).alias(\"high_income\")\n",
    ").drop_nulls(\"high_income\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "e493874e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# drop columns that we arent training on\n",
    "#df.drop(['respondentid', 'email', 'first_name', 'last_name'])# .to_dummies('domain').head(5)\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# drop strings and target column\n",
    "x = df.select(cs.numeric()).drop([\"respondentid\", \"income_int\", \"high_income\"]).to_numpy()\n",
    "\n",
    "\n",
    "y = df.select(\"high_income\").to_numpy().ravel()\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42) \n",
    "\n",
    "clf = DecisionTreeClassifier()  \n",
    "clf.fit(X_train, y_train) \n",
    "pred = clf.predict(X_test) "
   ]
