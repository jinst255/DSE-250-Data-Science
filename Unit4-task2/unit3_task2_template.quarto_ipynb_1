   "source": [
    "# The code below can serve as a template for all the rest of your queries. It is just missing the\n",
    "# SQL code. Put your SQL query in between the triple quotation marks to create the query. The records will be stored in 'results', which is a polars data frame\n",
    "\n",
    "q = \"\"\"\n",
    "    SELECT \n",
    "      playerID, \n",
    "      yearID, \n",
    "      CAST(H AS REAL) / AB AS \"batting_average\"\n",
    "    FROM Batting                                    -- pull from this part of the database\n",
    "    WHERE AB >= 1                                   -- This keeps only player with >= 1 bats\n",
    "    ORDER BY \"batting_average\" DESC, playerID ASC   -- This sorts it\n",
    "    LIMIT 5                                         -- This only show highest 5\n",
    "\"\"\"\n",
    "result = pl.read_database(q, con)\n",
    "display(result)\n"
