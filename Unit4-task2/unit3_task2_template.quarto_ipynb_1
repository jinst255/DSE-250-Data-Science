    "# Include and execute your code here\n",
    "\n",
    "q = \"\"\"\n",
    "    SELECT \n",
    "      playerID, \n",
    "      yearID, \n",
    "      CAST(SUM(H) AS REAL) / SUM(AB) AS \"batting_average\"\n",
    "    FROM Batting                                    -- pull from this part of the database\n",
    "    WHERE AB >= 100                                   -- This keeps only player with >= 100 bats\n",
    "      GROUP BY playerID\n",
    "    ORDER BY \"batting_average\" DESC, playerID ASC   -- This sorts it\n",
    "    LIMIT 5                                         -- This only show highest 5\n",
    "\"\"\"\n",
    "result = pl.read_database(q, con)\n",
