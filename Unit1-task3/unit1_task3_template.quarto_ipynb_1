   "source": [
    "# Q2\n",
    "'''\n",
    "- filter names only to Brigham (remove rows)\n",
    "- create a new column that add ID and UT together\n",
    "- create a new column that divides ID&UT by 'total' \n",
    "- graph the new column x='year' y='portionOfBrighams-ID&UT'\n",
    "'''\n",
    "\n",
    "\n",
    "# filter names only to Brigham (remove rows)\n",
    "Q2_df = df.filter(pl.col(\"name\") == \"Brigham\")\n",
    "\n",
    "# create a new column that add ID and UT together\n",
    "Q2_df = Q2_df.with_columns(\n",
    "  (pl.col(\"UT\") + pl.col(\"ID\")).alias(\"ID&UT_total\")\n",
    ")\n",
    "\n",
    "# create a new column that divides ID&UT by 'total' \n",
    "Q2_df = Q2_df.with_columns(\n",
    "  (pl.col(\"ID&UT_total\") / pl.col(\"Total\")\n",
    "  ).alias(\"portionOfBrighams-ID&UT\"))\n",
    "\n",
    "\n",
    "# graph the new column x='year' y='portionOfBrighams-ID&UT'\n",
    "(\n",
    "  ggplot(Q2_df, aes(x=\"year\", y=\"portionOfBrighams-ID&UT\"))\n",
    "  + geom_line()\n",
    "\n",
    "  + labs(\n",
    "    title=\"Percentage of Babies Named Brigham in Utah and Idaho\",\n",
    "    x=\"Year\",\n",
    "    y=\"Percentage of Brighams in ID & UT\"\n",
    "  )\n",
    "  + scale_x_continuous(format=\"d\")\n",
    "  + scale_y_continuous()\n",
    "\n",
    "  + theme(\n",
    "    title=element_text(size=14, hjust=0.5),\n",
    "  )\n",
    ")"
   ]
