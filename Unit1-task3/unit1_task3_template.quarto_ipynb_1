    "# Q1\n",
    "Q1_df = df.filter(pl.col(\"name\") == \"Justin\")\n",
    "\n",
    "Q1_df = Q1_df.with_columns(\n",
    "  (pl.col(\"UT\") + pl.col(\"ID\")).alias(\"ID_UT_total\")\n",
    ")\n",
    "\n",
    "\n",
    "(\n",
    "  ggplot(Q1_df, aes(x=\"year\", y=\"ID_UT_total\"))\n",
    "  + geom_line()\n",
    "  + geom_label(x=2010, y=300, label=\"My birth year\", hjust=0.5, vjust='bottom')\n",
    "  + geom_segment(x=2010, y=300, xend=2005, yend=147, arrow=arrow())\n",
    "\n",
    "  + labs(\n",
    "    title=\"Babies Named Justin in Utah and Idaho\",\n",
    "    x=\"Year\",\n",
    "    y=\"Total Babies\"\n",
    "  )\n",
    "  + scale_x_continuous(format=\"d\")\n",
    "\n",
    "  + theme(\n",
    "    title=element_text(size=14, hjust=0.5),\n",
    "  )\n",
    ")"
