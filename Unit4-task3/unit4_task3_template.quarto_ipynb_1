    "# Prep the ML data\n",
    "feature_columns = [\n",
    "    'quality_C', \n",
    "    'gartype_Att', \n",
    "    'arcstyle_ONE-STORY', \n",
    "    'livearea', \n",
    "    'stories', \n",
    "    'numbaths', \n",
    "    'sprice', \n",
    "    'basement',\n",
    "    'arcstyle_TWO-STORY', \n",
    "    'quality_B', \n",
    "    'finbsmnt'\n",
    "]\n",
    "\n",
    "x = df.select(feature_columns).to_numpy()\n",
    "y = df.select('before1980').to_numpy().ravel()\n",
    "\n",
    "x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42)\n",
    "\n",
    "\n",
    "\n",
    "# Import the 3 models and train them\n",
    "\n",
    "# Model 1: XGBoost Classifier\n",
    "from xgboost import XGBClassifier\n",
    "my_classifier1 = XGBClassifier(random_state=42)\n",
    "my_classifier1.fit(x_train, y_train)\n",
    "pred1 = my_classifier1.predict(x_test)\n",
    "\n",
    "# Model 2: Decision Tree Classifier\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "my_classifier2 = DecisionTreeClassifier(random_state=42)\n",
    "my_classifier2.fit(x_train, y_train)\n",
    "pred2 = my_classifier2.predict(x_test)\n",
    "\n",
    "# Model 3: Random Forest Classifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "my_classifier3 = RandomForestClassifier(random_state=42)\n",
    "my_classifier3.fit(x_train, y_train)\n",
    "pred3 = my_classifier3.predict(x_test)\n",
    "\n",
    "\n",
    "\n",
    "# Compare models\n",
    "from sklearn.metrics import confusion_matrix\n",
    "\n",
    "print(\"Model 1 - XGBoost Classifier (The original one I used)\")\n",
    "print(\"Accuracy:\", metrics.accuracy_score(y_test, pred1))\n",
    "print(\"Precision:\", metrics.precision_score(y_test, pred1))\n",
    "print(\"Recall:\", metrics.recall_score(y_test, pred1))\n",
    "\n",
    "print(\"\\nModel 2 - Decision Tree Classifier\")\n",
    "print(\"Accuracy:\", metrics.accuracy_score(y_test, pred2))\n",
    "print(\"Precision:\", metrics.precision_score(y_test, pred2))\n",
    "print(\"Recall:\", metrics.recall_score(y_test, pred2))\n",
    "\n",
    "print(\"\\nModel 3 - Random Forest Classifier\")\n",
    "print(\"Accuracy:\", metrics.accuracy_score(y_test, pred3))\n",
    "print(\"Precision:\", metrics.precision_score(y_test, pred3))\n",
    "print(\"Recall:\", metrics.recall_score(y_test, pred3))\n"
   ]
