    "# Q2 - Calculate the standard deviation of the data series (with the function std() ) after replacing the missing values with the median\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "c40a2032",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Standard Deviation: 2297.55\n"
     ]
    }
   ],
   "source": [
    "\"\"\"\n",
    "Todo list\n",
    "- [x] set 'missing' and 'N/A' to null\n",
    "- [x] cast to int\n",
    "- [x] replace missing values with median using median() and also \n",
    "- [x] calculate standard deviation\n",
    "- [x] display result to 2 decimal\n",
    "\n",
    "\"\"\"\n",
    "problem = pl.Series(['N/A', 18, 22, 45, 31, 'missing', 85, 38, 129, 8000, 22, 2], strict=False)\n",
    "\n",
    "\n",
    "\n",
    "# set 'missing' and 'N/A' to null\n",
    "problem = problem.replace(['missing', 'N/A'], None)\n",
    "\n",
    "# cast to int\n",
    "problem = problem.cast(pl.Int64)\n",
    "\n",
    "# replace missing values with median\n",
    "problem = problem.fill_null(problem.median())\n",
    "\n",
    "print(f\"Standard Deviation: {problem.std():.2f}\")"
   ]
