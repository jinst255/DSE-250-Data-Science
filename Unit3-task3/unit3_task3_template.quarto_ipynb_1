    "# I couldnt name a single team so I used AI to pick two teams. I got Los Angeles Dodgers(LAN) and New York Yankees(NYA)\n",
    "# It think it would be cool to see average salary for number of wins for both teams. (wins/salary)\n",
    "\n",
    "q1 = \"\"\"\n",
    "    SELECT\n",
    "      s.teamID,\n",
    "      s.salary\n",
    "    FROM salaries AS s\n",
    "\"\"\"\n",
    "q2 = \"\"\"\n",
    "    SELECT\n",
    "      t.teamID,\n",
    "      t.W\n",
    "    FROM teams AS t\n",
    "\"\"\"\n",
    "salaries = pl.read_database(q1, con)\n",
    "teams = pl.read_database(q2, con)\n",
    "\n",
    "# display(salaries)\n",
    "# display(teams)\n",
    "\n",
    "df = salaries.join(teams, on=\"teamID\", how=\"inner\").group_by(\"teamID\").agg(pl.col(\"salary\").mean().alias(\"avg_salary\"), pl.col(\"W\").mean().alias(\"avg_wins\")).with_columns((pl.col(\"avg_wins\") / pl.col(\"avg_salary\")).alias(\"wins_per_salary\")).filter(pl.col(\"teamID\").is_in([\"LAN\", \"NYA\"]))\n",
    "\n",
    "display(df)\n",
    "\n",
    "\n",
    "(\n",
    "  ggplot(data=df, mapping=aes(x=\"avg_wins\", y=\"avg_salary\", color=\"teamID\")) \n",
    "  + geom_bar(stat=\"identity\")\n",
    ")\n"
   ]
