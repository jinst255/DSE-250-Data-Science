    "import polars as pl\n",
    "from lets_plot import *\n",
    "import requests\n",
    "import io\n",
    "import polars.selectors as cs\n",
    "\n",
    "LetsPlot.setup_html(isolated_frame=True)\n",
    "\n",
    "# pull json data from https://github.com/byuidatascience/data4missing/raw/master/data-raw/flights_missing/flights_missing.json\n",
    "response = requests.get(\"https://github.com/byuidatascience/data4missing/raw/master/data-raw/flights_missing/flights_missing.json\")\n",
    "df = pl.read_json(io.BytesIO(response.content))"
   ]
