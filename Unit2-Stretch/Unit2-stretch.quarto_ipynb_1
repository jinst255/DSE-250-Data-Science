   "source": [
    "# Use cleaned data from Task 3 \n",
    "\n",
    "nullified_df = df\n",
    "\n",
    "# fix airport_code (!= 3 chars)\n",
    "errors = df.filter(pl.col(\"airport_code\").str.len_chars() != 3)\n",
    "# print(errors) # There are 0 errors in \"airport_code\"\n",
    "\n",
    "# fix airport_name (<4 chars)\n",
    "errors = df.filter(pl.col(\"airport_name\").str.len_chars() < 4)\n",
    "# print(errors[\"airport_name\"].unique()) # This prints out every unique value. In this case there are 56 instances of empty strings. \n",
    "\n",
    "nullified_df = nullified_df.with_columns(\n",
    "    pl.when(pl.col(\"airport_name\").str.len_chars() >= 4)\n",
    "    .then(pl.col(\"airport_name\"))\n",
    "    .otherwise(None)\n",
    "    .alias(\"airport_name\")\n",
    ")\n",
    "\n",
    "\n",
    "# fix month (!= .isin(Jan-Dec))\n",
    "months = [\"January\", \"February\", \"Febuary\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"]\n",
    "errors = df.filter(~pl.col(\"month\").is_in(months))\n",
    "# print(errors[\"month\"].unique()) # Its just the misspelling of \"February\" and also \"n/a\"\n",
    "# print(len(errors)) # 27 errors. (its \"n/a\")\n",
    "\n",
    "nullified_df = nullified_df.with_columns(\n",
    "    pl.when(pl.col(\"month\").is_in(months))\n",
    "    .then(pl.col(\"month\"))\n",
    "    .otherwise(None)\n",
    "    .alias(\"month\")\n",
    ")\n",
    "\n",
    "# if \"num_of_delays_carrier\" contains non numerical chars, convert to null\n",
    "errors = df.filter(pl.col(\"num_of_delays_carrier\").str.contains(r\"[^0-9]\"))\n",
    "# print(errors[\"num_of_delays_carrier\"].unique())\n",
    "# print(len(errors)) # 73 instances of \"1500+\"\n",
    "\n",
    "nullified_df = nullified_df.with_columns(\n",
    "  pl.when(pl.col(\"num_of_delays_carrier\") == \"1500+\")\n",
    "  .then(None)\n",
    "  .otherwise(pl.col(\"num_of_delays_carrier\"))\n",
    "  .alias(\"num_of_delays_carrier\")\n",
    ")\n",
    "\n",
    "\n",
    "# Cast num_of_delays_carrier to i64\n",
    "nullified_df = nullified_df.with_columns(\n",
    "    pl.col(\"num_of_delays_carrier\").cast(pl.Int64)\n",
    ")\n",
    "\n",
    "# Check all i64 columns for negative values, convert to null\n",
    "columns_that_are_ints = nullified_df.select(cs.by_dtype(pl.Int64)).columns\n",
    "\n",
    "nullified_df = nullified_df.with_columns(\n",
    "     [\n",
    "         pl.when(pl.col(col) < 0)\n",
    "         .then(None)\n",
    "         .otherwise(pl.col(col))\n",
    "         .alias(col)\n",
    "         for col in columns_that_are_ints\n",
    "     ]\n",
    " )\n",
    "\n",
    "cleaned_df = nullified_df\n",
    "\n",
    "# Calculate medians for all 5 ints.\n",
    "pl.col(\"minutes_delayed_carrier\").fill_null(pl.col(\"minutes_delayed_carrier\").median())\n",
    "\n",
    "cleaned_df = cleaned_df.with_columns(\n",
    "  pl.col(\"year\").fill_null(pl.col(\"year\").median())\n",
    ")\n",
    "\n",
    "cleaned_df = cleaned_df.with_columns(\n",
    "  cs.starts_with(\"num_of_\").fill_null(cs.starts_with(\"num_of_\").median())\n",
    ")\n",
    "\n",
    "cleaned_df = cleaned_df.with_columns(\n",
    "  cs.starts_with(\"minutes_\").fill_null(cs.starts_with(\"minutes_\").median())\n",
    ")\n",
    "\n",
    "df = cleaned_df"
   ]
